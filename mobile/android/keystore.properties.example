# Copie para keystore.properties (que NÃO vai para o git) e preencha. Gere o keystore uma vez e GUARDE-O:
#   keytool -genkey -v -keystore thinkrplay.jks -alias thinkrplay -keyalg RSA -keysize 2048 -validity 10000
# Sem este arquivo, "android-apk" e "android-aab" saem sem assinatura (a Play Store não aceita).
storeFile=../thinkrplay.jks
storePassword=
keyAlias=thinkrplay
keyPassword=
