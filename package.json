{
  "name": "thinkrplay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/check-logic.ts && tsx scripts/check-migrations.mjs && node scripts/check-sql.mjs && tsx scripts/test-api.mjs && tsx scripts/test-oauth.mjs && tsx scripts/test-security.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:admin": "node scripts/create-admin.mjs",
    "db:admin:sql": "node scripts/create-admin.mjs --sql",
    "db:schema": "node scripts/build-schema.mjs",
    "mobile": "node mobile/build.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^27.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
