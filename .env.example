# Conexão com pool: usada pela API. Com a integração Neon da Vercel ela já existe.
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Segredo aleatório com 32+ caracteres para assinar as sessões: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo
# Conexão direta (sem pool): usada por migrações e pelo script de admin
DATABASE_URL_UNPOOLED=postgres://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Opcional: segredo que define os puzzles de cada desafio (sem ele usa JWT_SECRET)
# CHALLENGE_SECRET=outro-segredo-aleatorio-com-32-ou-mais-caracteres

# E-mail de suporte (variável de BUILD, opcional mas recomendada): aparece no Perfil e é citado nos Termos e na Privacidade
VITE_SUPPORT_EMAIL=suporte@seudominio.com

# Anúncios (Google AdSense), variáveis de BUILD. Deixe vazias até ter domínio e aprovação; veja o README ("Anúncios").
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RANKING=
VITE_ADSENSE_SLOT_RESULT=
# true = anúncios de teste (não contam impressões nem cliques)
VITE_ADSENSE_TEST=

# Plano Premium (Stripe). Servidor (Vercel). Deixe vazias até criar a conta no Stripe; veja o README ("Plano Premium")
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Login com Google e Apple. Servidor (Vercel). Deixe vazias até criar os apps; veja o README ("Login com Google e Apple")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do arquivo .p8 da Apple, em uma linha, com as quebras de linha escritas como \n
APPLE_PRIVATE_KEY=
# Opcional: chave para cifrar o token da Apple no banco (sem ela usa JWT_SECRET)
OAUTH_TOKEN_KEY=
# Opcional: endereço do site usado nas URLs de retorno do pagamento
APP_URL=
# Opcional (build): preço exibido na página do Premium, igual ao do Stripe
VITE_PREMIUM_PRICE_LABEL=
