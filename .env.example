# Conexão com pool: usada pela API. Com a integração Neon da Vercel ela já existe.
DATABASE_URL=postgres://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Segredo aleatório com 32+ caracteres para assinar as sessões: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo
# Conexão direta (sem pool): usada por migrações e pelo script de admin
DATABASE_URL_UNPOOLED=postgres://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
